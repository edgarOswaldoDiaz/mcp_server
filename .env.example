APP_NAME="A2A Agent Node"
# Clave de entrada del agente. OBLIGATORIA: sin ella la app no arranca.
# Genera una con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=""
MCP_SERVER_URL="http://mcp-server:8000"
MCP_TIMEOUT_SECONDS=10.0
# Cuenta del agente en el MCP (las mismas MCP_AUTH_USERNAME / MCP_AUTH_PASSWORD del .env del MCP)
MCP_USERNAME=
MCP_PASSWORD=
