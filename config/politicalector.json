{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PermitirLecturaDatosPublicos",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::datos-publicos",
        "arn:aws:s3:::datos-publicos/*"
      ]
    },
    {
      "Sid": "DenegarEscrituraStrict",
      "Effect": "Deny",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::datos-publicos/*"
      ]
    }
  ]
}